{
    "name": "elegantmedia/laravel-simple-repository",
    "type": "library",
    "description": "Lightweight Repository pattern for Laravel 13+ projects with strict typing and modern PHP features.",
    "keywords": [
        "elegantmedia",
        "emedia",
        "laravel-simple-repository",
        "repository",
        "repositories"
    ],
    "homepage": "https://github.com/elegantmedia/Laravel-Simple-Repository",
    "license": "MIT",
    "authors": [
        {
            "name": "Elegant Media",
            "homepage": "https://www.elegantmedia.com.au",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.40",
        "illuminate/http": "^13.0",
        "illuminate/pagination": "^13.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5",
        "ramsey/uuid": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "ElegantMedia\\SimpleRepository\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ElegantMedia\\SimpleRepository\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "test:coverage": "phpunit",
        "check-style": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
        "fix-style": "php-cs-fixer fix --config=.php-cs-fixer.php",
        "analyse": "phpstan analyse --memory-limit=1G",
        "phpstan": "phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ElegantMedia\\SimpleRepository\\SimpleRepositoryServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
	"minimum-stability": "dev",
	"prefer-stable": true
}
